{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"cli": {
		"analytics": false
	},
	"projects": {
		"app": {
			"root": "",
			"sourceRoot": "src",
			"projectType": "application",
			"prefix": "app",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss"
				},
				"@schematics/angular:application": {
					"strict": true
				}
			},
			"architect": {
				"build": {
					"builder": "ngx-build-plus:browser",
					"options": {
						"outputPath": "dist",
						"index": "src/index.html",
						"polyfills": [
							"zone.js"
						],
						"tsConfig": "tsconfig.app.json",
						"inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "**/*",
                "input": "node_modules/@eui/core/assets/",
                "output": "./assets"
              },
              {
                "glob": "**/*",
                "input": "node_modules/@eui/styles/dist/assets/ecl",
                "output": "./assets/images/ecl"
              },
              {
                "glob": "**/*",
                "input": "node_modules/@eui/styles/dist/assets",
                "output": "./assets"
              },
              {
                "glob": "**/*",
                "input": "node_modules/@eui/ecl/assets/",
                "output": "./assets"
              },
              {
                "glob": "**/*",
                "input": "node_modules/@eui/styles/dist/styles",
                "output": "./assets"
              },
              {  "glob": "version",  "input": "src/assets/info",  "output": "./info"}
            ],
						"styles": [
							"node_modules/@eui/styles/dist/eui.css",
							"node_modules/@eui/styles/dist/eui-utilities.css",
							"node_modules/@eui/styles/dist/eui-theme-eui-legacy.css",
							"src/styles.scss"
						],
						"main": "src/main.ts",
						"extraWebpackConfig": "webpack.config.js",
						"commonChunk": false
					},
					"configurations": {
						"production": {
							"fileReplacements": [
								{
									"replace": "src/environments/environment.ts",
									"with": "src/environments/environment.prod.ts"
								}
							],
							"optimization": false,
							"outputHashing": "all",
							"sourceMap": false,
							"aot": true,
							"extractLicenses": true,
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "1mb",
									"maximumError": "2mb"
								}
							],
							"extraWebpackConfig": "webpack.prod.config.js"
						},
						"production-optimized": {
							"fileReplacements": [
								{
									"replace": "src/environments/environment.ts",
									"with": "src/environments/environment.prod.ts"
								}
							],
							"optimization": {
								"scripts": true,
								"styles": {
									"minify": false,
									"inlineCritical": true
								},
								"fonts": true
							},
							"outputHashing": "all",
							"sourceMap": false,
							"extractLicenses": true,
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "2mb",
									"maximumError": "6mb"
								}
							]
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "ngx-build-plus:dev-server",
					"options": {
						"buildTarget": "app:build",
						"port": 4202,
						"publicHost": "http://localhost:4202",
						"extraWebpackConfig": "webpack.config.js"
					},
					"configurations": {
						"proxy-mock": {
							"buildTarget": "app:build:development",
							"proxyConfig": "proxy-mock.conf.json"
						},
						"production": {
							"buildTarget": "app:build:production",
							"extraWebpackConfig": "webpack.prod.config.js"
						},
						"development": {
							"buildTarget": "app:build:development"
						}
					},
					"defaultConfiguration": "development"
				},
				"lint": {
					"builder": "@angular-eslint/builder:lint",
					"options": {
						"lintFilePatterns": [
							"src/**/*.ts",
							"src/**/*.html"
						],
						"eslintConfig": "src/.eslintrc.json"
					}
				},
				"test": {
          "builder": "@angular-devkit/build-angular:jest",
					"options": {
            "passWithNoTests": true,
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						],
						"tsConfig": "src/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "node_modules/@eui/core/assets/",
								"output": "./assets"
							},
							{
								"glob": "**/*",
								"input": "node_modules/@eui/styles/dist/assets/",
								"output": "./assets"
							}
						]
					}
				}
			}
		}
	}
}
